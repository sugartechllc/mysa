# Mysa Credentials
M2M_MYSA_USERNAME=your-email@example.com
M2M_MYSA_PASSWORD=your-password

# Local MQTT Broker Configuration
M2M_MQTT_HOST=localhost
M2M_MQTT_PORT=1883
# M2M_MQTT_USERNAME=
# M2M_MQTT_PASSWORD=
M2M_MQTT_CLIENT_NAME=mysa2mqtt
M2M_MQTT_TOPIC_PREFIX=mysa2mqtt

# General Configuration
# Log level: silent, fatal, error, warn, info, debug, trace (default: info)
M2M_LOG_LEVEL=info
# Log format: pretty, json (default: pretty)
# M2M_LOG_FORMAT=pretty
# Temperature unit: C, F (default: C)
M2M_TEMPERATURE_UNIT=C
# REST state poll interval in seconds: 0 to disable, or >= 30 (default: 60)
M2M_POLL_INTERVAL_SECONDS=60
# Optional rated wattage for V2 / In-Floor thermostats (comma-separated <device-id-or-name>=<watts>)
# M2M_HEATER_WATTS=Living Room=1500,Bedroom=1000
# File touched whenever Mysa cloud is reached, throttled to 1 write per 10s (for liveness healthchecks)
# M2M_HEARTBEAT_FILE=/tmp/mysa2mqtt.heartbeat

